# Copie para .env e preencha apenas no seu computador. Nunca publique o arquivo .env.
# Gmail: ative a verificacao em duas etapas e gere uma senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Mesmo endereco de SMTP_USER (ex.: MAIL_FROM="Orcaviva <seuemail@gmail.com>")
MAIL_FROM=

# Em producao, preencha com a origem HTTPS publica do site, sem caminho final.
# PUBLIC_ORIGIN=https://orcaviva.seu-dominio.com
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
# Na rede local, deixe PUBLIC_ORIGIN sem definir e peca o link pelo IP do computador.
